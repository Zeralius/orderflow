<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%-18logger{0} %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Service output (prefixed with the service name) helps when a test fails -->
    <logger name="order-service" level="INFO"/>
    <logger name="inventory-service" level="INFO"/>
    <logger name="payment-service" level="INFO"/>
    <logger name="org.testcontainers" level="WARN"/>
    <logger name="tc" level="WARN"/>
    <logger name="com.github.dockerjava" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
